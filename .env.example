# Copy this file to .env before starting the stack.

ANTHROPIC_API_KEY=replace_with_your_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://your-compatible-anthropic-endpoint.example.com

APP_PORT=8080
BACKEND_PORT=8000
PROMETHEUS_UI_PORT=9090

APP_ENV=development
LOG_LEVEL=INFO
REDIS_PASSWORD=replace_with_a_strong_password
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000
PROMETHEUS_RETENTION=7d
