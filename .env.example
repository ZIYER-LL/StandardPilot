# Copy this file to .env before starting the stack.

# Legacy/default provider configuration (also used as PRIMARY defaults)
LLM_PROVIDER=zhipu
ZHIPU_API_KEY=replace_with_your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_THINKING_ENABLED=false

# Final answer / worker model pool
PRIMARY_LLM_PROVIDER=zhipu
PRIMARY_LLM_API_KEY=replace_with_your_primary_key
PRIMARY_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PRIMARY_LLM_MODEL=glm-4.7-flash
PRIMARY_LLM_MAX_CONCURRENCY=2

# Low-cost router pool. May use another provider/model to isolate rate limits.
# ROUTER_LLM_PROVIDER=deepseek
# ROUTER_LLM_API_KEY=replace_with_your_router_key
# ROUTER_LLM_BASE_URL=https://api.deepseek.com/v1
# ROUTER_LLM_MODEL=deepseek-chat
# ROUTER_LLM_MAX_CONCURRENCY=1

# Provider/model fallback used after bounded retry or 429.
# FALLBACK_LLM_PROVIDER=anthropic
# FALLBACK_LLM_API_KEY=replace_with_your_fallback_key
# FALLBACK_LLM_BASE_URL=https://api.anthropic.com
# FALLBACK_LLM_MODEL=claude-3-5-haiku-latest
# FALLBACK_LLM_MAX_CONCURRENCY=1

# Response profiles (override only after evaluation)
BUDGET_BRIEF_MAX_TOKENS=384
BUDGET_STANDARD_MAX_TOKENS=1024
BUDGET_DETAILED_MAX_TOKENS=2048
BUDGET_REPORT_MAX_TOKENS=3072

APP_PORT=8080
BACKEND_PORT=8000
PROMETHEUS_UI_PORT=9090
APP_ENV=development
LOG_LEVEL=INFO
REDIS_PASSWORD=replace_with_a_strong_password
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000
PROMETHEUS_RETENTION=7d
