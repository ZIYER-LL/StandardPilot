{
  "name": "StandardPilot Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080, 8000, 9090],
  "portsAttributes": {
    "8080": {
      "label": "StandardPilot Web",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8000": {
      "label": "FastAPI Swagger",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "9090": {
      "label": "Prometheus",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "secrets": {
    "ZHIPU_API_KEY": {
      "description": "Zhipu GLM API key used by the StandardPilot backend"
    },
    "ANTHROPIC_API_KEY": {
      "description": "Optional Anthropic API key used when LLM_PROVIDER=anthropic"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Vue.volar",
        "ms-azuretools.vscode-containers",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/node_modules": true
        }
      }
    }
  }
}
